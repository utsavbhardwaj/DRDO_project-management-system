# PostgreSQL / Neon Database URL with SSL enabled
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Port (Cloud providers like Render inject this automatically)
PORT=5005

# JWT Secret for token signing
JWT_SECRET="your_production_jwt_secret_key"

# Email SMTP Settings (e.g. Brevo / SendGrid / Resend)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM_EMAIL=your_verified_sender_email@domain.com

# Frontend Application URL (used for email verification & reset password links)
FRONTEND_URL="https://your-drdo-app.vercel.app"
